#version 460

layout(local_size_x = 1) in;

// Two structs with the same layout but different names are two C++ types.
struct A
{
    float x;
};

struct B
{
    float x;
};

layout(push_constant) uniform Twins
{
    A a;
    B b;
} pc;

layout(set = 0, binding = 0) buffer Out
{
    uint words[];
};

void main()
{
    words[0] = uint(pc.a.x + pc.b.x);
}
