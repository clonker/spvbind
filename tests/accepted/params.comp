#version 460

layout(local_size_x = 64) in;

struct Range
{
    float lo;
    float hi;
};

layout(push_constant) uniform Params
{
    uint count;
    double scale;
    Range range;
};

layout(set = 0, binding = 0) buffer Values
{
    float values[];
};

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i < count)
        values[i] = clamp(float(double(values[i]) * scale), range.lo, range.hi);
}
