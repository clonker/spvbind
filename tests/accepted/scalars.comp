#version 460
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 1) in;

// Every scalar type spvbind supports, ordered so that std430 pads between most of them.
layout(push_constant) uniform Scalars
{
    uint8_t a;
    double b;
    int16_t c;
    int d;
    int64_t e;
    float f;
    uint16_t g;
    uint h;
    int8_t i;
    uint64_t j;
} pc;

layout(set = 0, binding = 0) buffer Out
{
    uint words[];
};

void main()
{
    words[0] = uint(pc.a) + uint(pc.h);
}
