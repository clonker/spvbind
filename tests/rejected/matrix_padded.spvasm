; A column-major mat2x3 with the std430 stride 16, which is not the column size 12: padded strides are not supported yet.
; target-env: vulkan1.3
               OpCapability Shader
               OpMemoryModel Logical GLSL450
               OpEntryPoint GLCompute %main "main" %pc
               OpExecutionMode %main LocalSize 1 1 1
               OpName %S "S"
               OpMemberName %S 0 "x"
               OpName %pc ""
               OpDecorate %S Block
               OpMemberDecorate %S 0 Offset 0
               OpMemberDecorate %S 0 MatrixStride 16
               OpMemberDecorate %S 0 ColMajor
       %void = OpTypeVoid
         %fn = OpTypeFunction %void
      %float = OpTypeFloat 32
         %v3 = OpTypeVector %float 3
     %mat2x3 = OpTypeMatrix %v3 2
          %S = OpTypeStruct %mat2x3
        %ptr = OpTypePointer PushConstant %S
         %pc = OpVariable %ptr PushConstant
       %main = OpFunction %void None %fn
      %label = OpLabel
               OpReturn
               OpFunctionEnd
