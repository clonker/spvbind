import Spvbind.Generate

/-!
# Printing the header, and the locations for the oracle

The printer is trusted, so it only spells out `Spec.Cpp.Ty`: each struct once, after the structs it uses, with its
padding and a `static_assert` on every offset, size and alignment of the model, which the C++ compiler then checks.
The type of each scalar member is checked too, from the `Scalar` rather than from the name `scalarName` gives it, so
that a wrong name is a compile error.

`printLocations` is the other output: `Ty.locations` of each block, one scalar per line, which is exactly what
`Guarantees.generate_correct` speaks about, for comparing another reflection library against.
-/

namespace Spvbind

open Spec (Id Scalar)
open Spec.Cpp (Ty Member)

def scalarName : Scalar → String
  | .int width true => s!"std::int{width}_t"
  | .int width false => s!"std::uint{width}_t"
  | .float width => if width = 32 then "float" else "double"

def typeName : Ty → String
  | .scalar s => scalarName s
  | .struct name _ => name

/-- What the compiler can check about the C++ type `expr` of a scalar, independently of `scalarName`: an integer is
integral with the scalar's signedness, a floating-point number is one in IEEE 754 format like SPIR-V's, and both
have the scalar's size. -/
def scalarCheck (expr : String) : Scalar → String
  | .int _ true => s!"std::is_integral_v<decltype({expr})> && std::is_signed_v<decltype({expr})>"
  | .int _ false => s!"std::is_integral_v<decltype({expr})> && std::is_unsigned_v<decltype({expr})>"
  | .float _ => s!"std::is_floating_point_v<decltype({expr})> && std::numeric_limits<decltype({expr})>::is_iec559"

def printStruct : String × List Member → String
  | (name, members) =>
    let (fields, _) := members.foldl (init := ("", 0)) fun (out, paddings) (.mk member padding type) =>
      if padding = 0 then (out ++ s!"    {typeName type} {member};\n", paddings)
      else
        (out ++ s!"    std::array<std::byte, {padding}> spvbindPadding{paddings}\{};\n    {typeName type} {member};\n",
          paddings + 1)
    let offsets := (members.zip (Spec.Cpp.Members.offsets 0 members)).foldl (init := "") fun out (.mk member _ _, o) =>
      out ++ s!"static_assert(offsetof({name}, {member}) == {o});\n"
    let types := members.foldl (init := "") fun out (.mk member _ type) =>
      match type with
      | .scalar s =>
        out ++ s!"static_assert({scalarCheck s!"{name}::{member}" s} && sizeof({name}::{member}) == {Spec.Cpp.Scalar.bytes s});\n"
      | .struct .. => out
    let t := Ty.struct name members
    s!"struct {name}\n\{\n{fields}};\n{offsets}{types}static_assert(sizeof({name}) == {t.size});\n\
      static_assert(alignof({name}) == {t.align});\n"

mutual
/-- `structs` followed by the structs `t` uses and `t`, each after the structs it uses, leaving out those that print
the same as one already there. Two that have the same name but differ are both kept, for `print` to reject. -/
def collect (structs : Array (String × List Member)) : Ty → Array (String × List Member)
  | .scalar _ => structs
  | .struct name members =>
    let structs := collectMembers structs members
    if structs.any (fun s => s.1 == name && printStruct s == printStruct (name, members)) then structs
    else structs.push (name, members)

def collectMembers (structs : Array (String × List Member)) : List Member → Array (String × List Member)
  | [] => structs
  | .mk _ _ type :: members => collectMembers (collect structs type) members
end

/-- The header for the push constant blocks `blocks` of the module at `source`. -/
def print (source : String) (blocks : List (Id × Ty)) : Except String String := do
  let structs := blocks.foldl (fun structs (_, t) => collect structs t) #[]
  for (_, t) in blocks do
    if let .scalar _ := t then throw "a push constant variable is not a struct"
  unless distinct (structs.toList.map (·.1)) do
    throw "two different structs have the same name"
  return s!"// Generated by spvbind from {source}.\n#pragma once\n\n#include <array>\n#include <climits>\n\
    #include <cstddef>\n#include <cstdint>\n#include <limits>\n#include <type_traits>\n\n\
    static_assert(CHAR_BIT == 8);\n" ++
    String.join (structs.toList.map (fun s => "\n" ++ printStruct s))

/-- A scalar as the oracle output names it: `i` or `u` for signed and unsigned integers, `f` for floating-point
numbers, then the width in bits. -/
def scalarCode : Scalar → String
  | .int width true => s!"i{width}"
  | .int width false => s!"u{width}"
  | .float width => s!"f{width}"

/-- Every scalar of every push constant block, one per line, as `Ty.locations` gives them: the variable's id; the
struct names, member indices and member names along the path, each list joined with `/`; the byte offset from the
start of the block; and the scalar. Fields are separated by tabs. -/
def printLocations (blocks : List (Id × Ty)) : String :=
  String.join <| blocks.flatMap fun (v, t) => t.locations.map fun l =>
    let column (f : Spec.Step → String) : String := "/".intercalate (l.path.map f)
    s!"{v}\t{column (·.struct)}\t{column (fun s => toString s.index)}\t{column (·.member)}\t{l.offset}\t\
      {scalarCode l.scalar}\n"

end Spvbind
