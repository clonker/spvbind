import Spvbind.Generate

/-!
# Printing the header

The printer is trusted, so it only spells out `Spec.Cpp.Ty`: each struct once, after the structs it uses, with its
padding and a `static_assert` on every offset, size and alignment of the model, which the C++ compiler then checks.
-/

namespace Spvbind

open Spec (Id Scalar)
open Spec.Cpp (Ty Member)

def scalarName : Scalar → String
  | .int width true => s!"std::int{width}_t"
  | .int width false => s!"std::uint{width}_t"
  | .float width => if width = 32 then "float" else "double"

def typeName : Ty → String
  | .scalar s => scalarName s
  | .struct name _ => name

def printStruct : String × List Member → String
  | (name, members) =>
    let (fields, _) := members.foldl (init := ("", 0)) fun (out, paddings) (.mk member padding type) =>
      if padding = 0 then (out ++ s!"    {typeName type} {member};\n", paddings)
      else
        (out ++ s!"    std::array<std::byte, {padding}> spvbindPadding{paddings}\{};\n    {typeName type} {member};\n",
          paddings + 1)
    let offsets := (members.zip (Spec.Cpp.Members.offsets 0 members)).foldl (init := "") fun out (.mk member _ _, o) =>
      out ++ s!"static_assert(offsetof({name}, {member}) == {o});\n"
    let t := Ty.struct name members
    s!"struct {name}\n\{\n{fields}};\n{offsets}static_assert(sizeof({name}) == {t.size});\n\
      static_assert(alignof({name}) == {t.align});\n"

mutual
/-- `structs` followed by the structs `t` uses and `t`, each after the structs it uses, leaving out those that print
the same as one already there. Two that have the same name but differ are both kept, for `print` to reject. -/
def collect (structs : Array (String × List Member)) : Ty → Array (String × List Member)
  | .scalar _ => structs
  | .struct name members =>
    let structs := collectMembers structs members
    if structs.any (fun s => s.1 == name && printStruct s == printStruct (name, members)) then structs
    else structs.push (name, members)

def collectMembers (structs : Array (String × List Member)) : List Member → Array (String × List Member)
  | [] => structs
  | .mk _ _ type :: members => collectMembers (collect structs type) members
end

/-- The header for the push constant blocks `blocks` of the module at `source`. -/
def print (source : String) (blocks : List (Id × Ty)) : Except String String := do
  let structs := blocks.foldl (fun structs (_, t) => collect structs t) #[]
  for (_, t) in blocks do
    if let .scalar _ := t then throw "a push constant variable is not a struct"
  unless distinct (structs.toList.map (·.1)) do
    throw "two different structs have the same name"
  return s!"// Generated by spvbind from {source}.\n#pragma once\n\n#include <array>\n#include <climits>\n\
    #include <cstddef>\n#include <cstdint>\n\nstatic_assert(CHAR_BIT == 8);\n" ++
    String.join (structs.toList.map (fun s => "\n" ++ printStruct s))

end Spvbind
